# Copy this file to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg DSN used by the Box and the shared trace layer at runtime.
#
# Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://jokebox:changeme@localhost:5432/jokebox
#
# Neon (serverless Postgres) — use the pooler hostname for the runtime app
# and the direct hostname for Alembic migrations and tests.
# ssl=require is mandatory; prepared_statement_cache_size=0 is needed for
# Neon's PgBouncer pooler (transaction mode) — already set in shared/db.py.
#
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/jokebox?ssl=require

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by joker/realtime.py (Realtime API), joker/generate.py,
# and all Librarian model calls.
OPENAI_API_KEY=sk-...

# ── Test database ─────────────────────────────────────────────────────────────
# Overrides DATABASE_URL in pytest.  Points at a scratch schema that is
# created and dropped by the session-scoped fixture in box/tests/conftest.py.
# Leave unset to fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://jokebox:changeme@localhost:5432/jokebox_test
# Neon — use the DIRECT hostname for tests (not the pooler) so the
# session-scoped CREATE/DROP TABLE DDL runs outside a transaction:
# TEST_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/jokebox_test?ssl=require
