# Copy this file to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg DSN used by the Box and the shared trace layer at runtime.
#
# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://jokebox:changeme@localhost:5432/jokebox
#
# Neon (this project uses Neon serverless Postgres):
# Use the POOLER hostname for the runtime app.
# asyncpg requires ssl=require (not sslmode=); drop channel_binding.
DATABASE_URL=postgresql+asyncpg://neondb_owner:CHANGE_ME@ep-YOUR_ENDPOINT-pooler.us-west-2.aws.neon.tech/neondb?ssl=require

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by joker/realtime.py (Realtime API), joker/generate.py,
# and all Librarian model calls.
OPENAI_API_KEY=sk-...

# ── Model selection ───────────────────────────────────────────────────────────
# All model names are set in shared/models.py with these defaults.
# Override here to change without touching code.
#
# High-stakes reasoning (taxonomy + generation + set design) — default: o3
# CLASSIFY_MODEL=o3
# GENERATE_GOOD=o3
# SETBUILD_MODEL=o3
#
# Fast/cheap helpers — default: gpt-4o-mini
# SUGGEST_MODEL=gpt-4o-mini
# SCORE_MODEL=gpt-4o-mini
# METADATA_MODEL=gpt-4o-mini
#
# Deliberate bad-joke path — keep on the weaker model; this is intentional.
# GENERATE_BAD=gpt-4o-mini

# ── Test database ─────────────────────────────────────────────────────────────
# Overrides DATABASE_URL in pytest.  Points at a scratch schema that is
# created and dropped by the session-scoped fixture in box/tests/conftest.py.
#
# Neon: use the DIRECT hostname (no -pooler) so session-scoped DDL
# (CREATE TABLE / DROP TABLE) runs outside PgBouncer transaction mode.
# This project uses a separate Neon project for tests.
TEST_DATABASE_URL=postgresql+asyncpg://neondb_owner:CHANGE_ME@ep-YOUR_TEST_ENDPOINT.c-2.us-west-2.aws.neon.tech/neondb?ssl=require

# ── Voice provider ────────────────────────────────────────────────────────────
# Select the voice transport layer.  Supported values: elevenlabs (default),
# openai (preserved for fallback).
# VOICE_PROVIDER=elevenlabs

# ── ElevenLabs (Conversational AI voice layer) ────────────────────────────────
# Required when VOICE_PROVIDER=elevenlabs.
# API key — never expose to the browser.  All ElevenLabs calls are server-side.
ELEVENLABS_API_KEY=sk_...

# Agent ID — run `python -m joker.voice.setup_agent` to create the Joker agent
# and obtain this ID.  If unset, the session startup creates the agent
# automatically (slower first session).
# ELEVENLABS_AGENT_ID=agent_...

# Voice ID for the host.  Default: Charlie (IKne3meq5aSn9XLyUdCD).
# Override to any ElevenLabs voice that fits the late-night monologue register.
# See docs/DECISIONS.md 2026-09-02 "ElevenLabs voice layer" for the rationale.
# ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD

# ── Box HTTP client (joker/librarian/seed) ───────────────────────────────────
# All Box I/O goes through shared/box_client.py. Swap these to retarget the
# winning Box at 6pm — one module, these env vars.
# BOX_BASE_URL=http://localhost:8000
# BOX_API_KEY=jbx_...
# BOX_TRANSPORT=http
